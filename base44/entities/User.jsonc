{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Workspaces this user belongs to. Written only by the server from membership records; the tenant boundary every workspace record is checked against.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}